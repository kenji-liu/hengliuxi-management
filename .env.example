# AI provider configuration (never commit real keys)
#
# 本機使用方式：把這個檔複製成 .env（同一層目錄），填入實際金鑰後重啟後端。
#     copy .env.example .env
# .env 已列入 .gitignore，不會進版控。
# 啟動時後端會自動載入；已存在的系統環境變數優先，故不影響 Render 部署。
# 確認是否載入成功：GET /api/ai-check

# OpenRouter is the preferred provider for the shared RAG answer pipeline.
# 取得金鑰：https://openrouter.ai → Keys（格式 sk-or-v1-...）
OPENROUTER_API_KEY=your-openrouter-key

# Central model routing. Change model IDs here or in Render environment variables;
# never put them or any API key in frontend JavaScript.
#
# ⚠️ 下列為「免費模型」設定，OpenRouter 帳號沒有儲值也能運作。
#    程式內建預設（ai_model_config.py）是付費模型（claude-sonnet 等），
#    帳號額度用盡時會回 HTTP 402，AI 便退回未整理的檢索結果。
#    若已為 OpenRouter 儲值、想要更好的答案品質，
#    可改回 ~anthropic/claude-sonnet-latest 或 openrouter/auto。
#    免費模型清單會變動，可用 /api/ai-check 確認目前是否正常。
AI_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL_FAST_FALLBACK=openrouter/free
AI_MODEL_PRO=nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL_PRO_FALLBACK=openrouter/free
AI_MODEL_DEEP=openrouter/free
AI_MODEL_DEEP_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
AI_ENABLE_LEGACY_PROVIDER_FALLBACK=false

# Optional per-mode tuning
AI_TOP_K_FAST=3
AI_TOP_K_PRO=4
AI_TOP_K_DEEP=5
AI_MAX_TOKENS_FAST=500
AI_MAX_TOKENS_PRO=800
AI_MAX_TOKENS_DEEP=1500
OLLAMA_SMART_TIMEOUT=8

# Legacy provider fallbacks
# Gemini is available when OpenRouter cannot respond.
GOOGLE_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL is optional; the backend discovers an available Flash model.
# GEMINI_MODEL=gemini-3.6-flash

# Provider fallback order
# 註：Groq 在 Render 免費方案會被 Cloudflare 依 ASN 封鎖（error 1010），
# 本機則可正常使用；OpenRouter 放第一順位對兩邊都適用。
AI_PROVIDER_PRIORITY=openrouter,gemini,claude,groq

# Anthropic API Configuration
# Get your API key from https://console.anthropic.com/api_keys

# Replace with your actual API key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Set custom model
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional: Set API timeout (seconds)
# ANTHROPIC_API_TIMEOUT=30
