# AI provider configuration (never commit real keys)
#
# 本機使用方式：把這個檔複製成 .env（同一層目錄），填入實際金鑰後重啟後端。
#     copy .env.example .env
# .env 已列入 .gitignore，不會進版控。
# 啟動時後端會自動載入；已存在的系統環境變數優先，故不影響 Render 部署。
# 確認是否載入成功：GET /api/ai-check

# OpenRouter is the preferred provider for the shared RAG answer pipeline.
# 取得金鑰：https://openrouter.ai → Keys（格式 sk-or-v1-...）
OPENROUTER_API_KEY=your-openrouter-key

# OpenCode Zen —— 第二個免費模型閘道（選填，但強烈建議設定）
# OpenRouter 的免費模型有「每日上限」，額滿時會回 429 free-models-per-day，
# 付費額度用盡則回 402；任一情況都會讓答詢退回未整理的檢索結果。
# 設定本金鑰後，Agent 會在 OpenRouter 失敗時自動改用 Zen。
# 取得金鑰：https://opencode.ai → Zen → API Keys
OPENCODE_ZEN_API_KEY=your-opencode-zen-key
# ── OpenCode Go（$10/月訂閱，與 Zen 共用同一把金鑰）──────────
# 有訂閱時優先使用；模型品質與速度均明顯優於免費模型，
# 且不受 OpenRouter 每日免費上限與付費額度影響。
# 實測統整耗時：minimax-m3 5.5s／kimi-k3 22s／免費 nemotron-3-ultra 52s
OPENCODE_GO_MODEL=minimax-m3
# 可選：kimi-k3（較慢但研判更深入）、qwen3.8-max、glm-5.3
# 停用 Go、只用免費模型時設為 false
# OPENCODE_GO_ENABLED=true

# 可用免費模型：nemotron-3.5-lightning-free（預設）、hy3-free、
#               mimo-v2.5-free、nemotron-3-ultra-free
# ZEN_MODEL=nemotron-3.5-lightning-free

# Central model routing. Change model IDs here or in Render environment variables;
# never put them or any API key in frontend JavaScript.
#
# 設定原則：主要模型用付費（品質較好），備援一律指定免費模型。
# 後端會把兩者一起送進 OpenRouter 的 models 陣列，由平台自動路由；
# 實測帳號額度為零時會自動改用免費備援並正常作答，
# 不會像單指定付費模型那樣回 HTTP 402 而退成未整理的檢索結果。
# 因此儲值與否都能運作，儲值後也不需要改設定。
#
# 免費模型清單會變動（下架或限流），可用 /api/ai-check 確認目前狀態。
# 實測可用：nvidia/nemotron-3-super-120b-a12b:free（快、繁中正常）、
#           openrouter/free（較慢但穩定）。
AI_MODEL_FAST=google/gemini-2.5-flash-lite
AI_MODEL_FAST_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL_PRO=~anthropic/claude-sonnet-latest
AI_MODEL_PRO_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL_DEEP=openrouter/auto
AI_MODEL_DEEP_FALLBACK=openrouter/free
AI_ENABLE_LEGACY_PROVIDER_FALLBACK=false

# Optional per-mode tuning
AI_TOP_K_FAST=3
AI_TOP_K_PRO=4
AI_TOP_K_DEEP=5
AI_MAX_TOKENS_FAST=500
AI_MAX_TOKENS_PRO=800
AI_MAX_TOKENS_DEEP=1500
OLLAMA_SMART_TIMEOUT=8

# Legacy provider fallbacks
# Gemini is available when OpenRouter cannot respond.
GOOGLE_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL is optional; the backend discovers an available Flash model.
# GEMINI_MODEL=gemini-3.6-flash

# Provider fallback order
# 註：Groq 在 Render 免費方案會被 Cloudflare 依 ASN 封鎖（error 1010），
# 本機則可正常使用；OpenRouter 放第一順位對兩邊都適用。
AI_PROVIDER_PRIORITY=openrouter,gemini,claude,groq

# Anthropic API Configuration
# Get your API key from https://console.anthropic.com/api_keys

# Replace with your actual API key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Set custom model
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional: Set API timeout (seconds)
# ANTHROPIC_API_TIMEOUT=30

# ── 向量語意檢索（選填，強烈建議）──────────────────────────
# 未設定時檢索為純 BM25 關鍵字比對；設定後會以 RRF 融合語意檢索，
# 「用詞不同但語意相近」的問題命中率明顯提升
#（例如問「魚游不上去怎麼辦」也能找到「魚道通行效能」的段落）。
#
# 必須使用 Jina：向量庫是以 jina-embeddings-v3（768 維）建立的，
# 換別家模型維度與語意空間都不同，混用會查出錯誤結果。
# 只需為「問題」轉向量（每次約 50 tokens），免費額度 10M ≈ 20 萬次查詢。
# 取得金鑰：https://jina.ai/embeddings （免信用卡）
JINA_API_KEY=your-jina-key
